generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum ShopPlan {
  START
  BUSINESS
  PRO
}

enum PlatformUserRole {
  PLATFORM_SUPER_ADMIN
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthSessionScope {
  PLATFORM
  SHOP
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Shop {
  id        String     @id @default(uuid())
  name      String
  ownerName String     @default("") @map("owner_name")
  phone     String     @default("")
  plan      ShopPlan   @default(START)
  status    ShopStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  users     User[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@map("shops")
}

model PlatformUser {
  id           String             @id @default(uuid())
  login        String             @unique
  passwordHash String             @map("password_hash")
  role         PlatformUserRole    @default(PLATFORM_SUPER_ADMIN)
  status       PlatformUserStatus  @default(ACTIVE)
  lastLoginAt  DateTime?          @map("last_login_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  sessions     AuthSession[]
  auditLogs    AuditLog[]

  @@map("platform_users")
}

model User {
  id           String        @id @default(uuid())
  shopId       String        @map("shop_id")
  fullName     String        @map("full_name")
  login        String        @unique
  passwordHash String        @map("password_hash")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  role         UserRole      @default(STAFF)
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sessions     AuthSession[]
  auditLogs    AuditLog[]

  @@index([shopId])
  @@map("users")
}

model AuthSession {
  id             String           @id @default(uuid())
  scope          AuthSessionScope
  tokenHash      String           @unique @map("token_hash")
  platformUserId String?          @map("platform_user_id")
  userId         String?          @map("user_id")
  status         SessionStatus    @default(ACTIVE)
  expiresAt      DateTime         @map("expires_at")
  revokedAt      DateTime?        @map("revoked_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  platformUser   PlatformUser?    @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scope, status])
  @@index([platformUserId])
  @@index([userId])
  @@map("auth_sessions")
}

model AuditLog {
  id             String        @id @default(uuid())
  shopId         String?       @map("shop_id")
  userId         String?       @map("user_id")
  platformUserId String?       @map("platform_user_id")
  action         String
  entity         String
  entityId       String?       @map("entity_id")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  shop           Shop?         @relation(fields: [shopId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([shopId])
  @@index([userId])
  @@index([platformUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
